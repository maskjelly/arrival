# Optional overrides. npm scripts load .env if it exists.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/arrival.sqlite

# Public HTTPS collector address used in generated snippets and agent discovery.
# PUBLIC_URL=https://arrival.example.com

# Required before exposing the server beyond localhost.
# ADMIN_PASSWORD=

# Set only when requests arrive through a trusted reverse proxy.
# TRUST_PROXY=loopback
