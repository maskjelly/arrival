{
  "name": "arrival-agent-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-hosted.mjs",
    "start": "tsx --env-file-if-exists=.env server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm run format:check && npm test && npm run typecheck && npm run test:ui",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check api scripts vercel.json src server public/*.css public/*.js sdk tests docs README.md vite.config.ts playwright.config.ts tsconfig.json package.json index.html .github/workflows/ci.yml",
    "geo:update": "tsx --env-file-if-exists=.env server/download-geo.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@libsql/client": "0.18.0",
    "@phosphor-icons/react": "2.1.10",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0",
    "maxmind": "5.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Agent analytics with customizable check-in, request evidence, and visit timelines.",
  "license": "UNLICENSED"
}
